class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 32


# ------------------------------------------------------------------ commands
def cmd_serve(args):
    c = cfg()
    bad = config_problem(c)
    if bad:
        print(f"phone-hub: not starting: {bad}", file=sys.stderr)
        return 2
    private_dir(STATE_DIR)
    private_dir(CONFIG_DIR)
    try:
        srv = Server(("127.0.0.1", int(c["port"])), Handler)
    except OSError as e:
        print(f"phone-hub: cannot listen on 127.0.0.1:{c['port']}: {e}", file=sys.stderr)
        return 1
    audit("server_start", port=srv.server_address[1])
    with open(os.path.join(STATE_DIR, "server.pid"), "w") as f:
        f.write(str(os.getpid()))
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0

def healthy(port, timeout=1.0):
    try:
        conn = http.client.HTTPConnection("127.0.0.1", int(port), timeout=timeout)
        conn.request("GET", "/healthz")
        r = conn.getresponse()
        ok = r.status == 200 and r.read() == b"ok"
        conn.close()
        return ok
    except Exception:
        return False

SUPERVISOR_PID = os.path.join(STATE_DIR, "supervisor.pid")

def supervisor_alive():
    """True only if the pid file names a live process whose command line is our `supervise` (a recycled pid does not count)."""
    try:
        pid = int(open(SUPERVISOR_PID).read().strip())
        os.kill(pid, 0)
        cmd = subprocess.run(["ps", "-p", str(pid), "-o", "command="], capture_output=True, text=True, timeout=5).stdout
    except (OSError, ValueError, subprocess.SubprocessError):
        return False
    return "supervise" in cmd and os.path.basename(os.path.abspath(__file__)) in cmd

def cmd_supervise(args):
    """Keep `serve` running. When it exits, wait (2 s, doubling to 30 s while it keeps dying within a minute) and start it again.
    SIGTERM stops the server and then this loop, so `kill <supervisor.pid>` really stops everything."""
    private_dir(STATE_DIR)
    with open(SUPERVISOR_PID, "w") as f:
        f.write(str(os.getpid()))
    box, stopping = {"p": None}, []
    def stop(signum, frame):
        stopping.append(signum)
        p = box["p"]
        if p is not None and p.poll() is None:
            p.terminate()
    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGINT, stop)
    delay = 2
    while not stopping:
        t0 = time.time()
        box["p"] = subprocess.Popen([sys.executable, os.path.abspath(__file__), "serve"], stdin=subprocess.DEVNULL, close_fds=True)
        if stopping:
            box["p"].terminate()
        rc = box["p"].wait()
        if stopping:
            break
        if rc == 2:                     # a configuration error: starting again cannot fix it
            audit("supervisor_stop", reason="config")
            break
        up = int(time.time() - t0)
        audit("server_exit", rc=rc, up_secs=up)
        delay = 2 if up > 60 else min(delay * 2, 30)
        end = time.time() + delay
        while time.time() < end and not stopping:
            time.sleep(0.2)
    try:
        os.unlink(SUPERVISOR_PID)
    except OSError:
        pass
    return 0

def cmd_ensure(args):
    c = cfg()
    if healthy(c["port"]):
        print("phone-hub: already running")
        return 0
    bad = config_problem(c)
    if bad:
        print(f"phone-hub: not starting: {bad}", file=sys.stderr)
        return 1
    private_dir(STATE_DIR)
    if not supervisor_alive():
        log = open(SERVER_LOG, "ab")
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "supervise"], stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                         start_new_session=True, close_fds=True)
    for _ in range(80):                 # 12 s: covers the supervisor's own 2 s pause after a restart
        time.sleep(0.15)
        if healthy(c["port"]):
            print("phone-hub: started")
            return 0
    print("phone-hub: did not start (see server.log)", file=sys.stderr)
    return 1

def cmd_restart(args):
    """Stop the server process. The supervisor starts it again from the file on disk (new code, same pairing and PIN)."""
    try:
        os.kill(int(open(os.path.join(STATE_DIR, "server.pid")).read().strip()), 15)
    except (OSError, ValueError):
        pass
    for _ in range(30):
        if not healthy(cfg()["port"]):
            break
        time.sleep(0.1)
    return cmd_ensure(args)

WEAK = {"123456", "1234567", "12345678", "654321", "7654321", "87654321", "111111", "000000", "121212", "112233", "123123"}

def cmd_set_pin(args):
    c = cfg()
    if args.stdin:
        pin = sys.stdin.readline().rstrip("\n")
    else:
        pin = getpass.getpass("New PIN (digits, at least %d): " % c["pin_min_len"])
        if getpass.getpass("Again: ") != pin:
            print("phone-hub: the two entries differ", file=sys.stderr)
            return 1
    if not pin.isdigit() or len(pin) < int(c["pin_min_len"]):
        print(f"phone-hub: the PIN must be digits only, at least {c['pin_min_len']} long", file=sys.stderr)
        return 1
    if pin in WEAK or len(set(pin)) == 1:
        print("phone-hub: that PIN is too easy to guess", file=sys.stderr)
        return 1
    salt = pysecrets.token_bytes(16)
    with SLOCK:
        d = sload()
        d["pin"] = {"salt": base64.b64encode(salt).decode(), "iters": PIN_ITERS, "hash": base64.b64encode(hash_pin(pin, salt)).decode()}
        d["fail"] = {"global": {"n": 0, "until": 0}, "dev": {}}
        ssave(d)
    audit("pin_set")
    print("phone-hub: PIN set")
    return 0

def cmd_pair(args):
    c = cfg()
    code = words_code()
    with SLOCK:
        d = sload()
        d["pair"] = {"hash": sha(code), "expires": now() + int(c["pair_ttl_secs"]), "fails": 0}
        d.pop("pair_locked_until", None)
        ssave(d)
    audit("pair_started")
    print(f"\n  1. On the phone, open  https://{c['host']}  (best: from the Home Screen icon, see the page's tip)")
    print(f"  2. Enter this code:    {code}")
    print(f"     Valid {int(c['pair_ttl_secs']) // 60} minutes, works once.\n")
    return 0

def cmd_devices(args):
    d = sload()
    if not d["devices"]:
        print("no paired devices")
    for h, r in d["devices"].items():
        print(f"{h[:8]}  {r.get('label','?'):<20} paired {iso(r.get('created'))}  last seen {iso(r.get('last_seen'))}")
    return 0

def cmd_revoke(args):
    with SLOCK:
        d = sload()
        hit = [h for h in d["devices"] if h.startswith(args.id)]
        if len(hit) != 1:
            print("phone-hub: no unique device with that id", file=sys.stderr)
            return 1
        label = d["devices"][hit[0]].get("label")
        del d["devices"][hit[0]]
        ssave(d)
    audit("revoke", dev=label)
    print(f"phone-hub: revoked {label}. Sessions of that device end at the next request.")
    return 0

def cmd_off(args):
    private_dir(STATE_DIR)
    open(DISABLED_FILE, "w").close()
    audit("kill_switch_on")
    print("phone-hub: OFF (everything answers 503)")
    return 0

def cmd_on(args):
    try:
        os.unlink(DISABLED_FILE)
    except FileNotFoundError:
        pass
    audit("kill_switch_off")
    print("phone-hub: on")
    return 0

def cmd_status(args):
    c = cfg()
    d = sload()
    print(f"server      : {'running' if healthy(c['port']) else 'not running'} on 127.0.0.1:{c['port']}")
    print(f"kill switch : {'OFF (503)' if os.path.exists(DISABLED_FILE) else 'on'}")
    print(f"config      : {config_problem(c) or 'login and host set'}")
    print(f"PIN         : {'set' if d.get('pin') else 'NOT set (phone-hub set-pin)'}")
    print(f"devices     : {len(d['devices'])}")
    p = d.get("pair") or {}
    print(f"pairing     : {'code active' if p and now() < p.get('expires', 0) else 'none active'}")
    try:
        ts = subprocess.run(["tailscale", "serve", "status"], capture_output=True, text=True, timeout=6).stdout.strip().splitlines()
        print("tailnet     : " + (ts[0] if ts else "(nothing published)"))
    except Exception:
        print("tailnet     : (could not ask tailscale)")
    return 0

def cmd_log(args):
    try:
        lines = open(AUDIT_FILE).read().splitlines()[-args.n:]
    except OSError:
        lines = []
    print("\n".join(lines) or "(empty)")
    return 0

def cmd_selftest(args):
    c = cfg()
    if not os.environ.get("PHONE_HUB_STATUS_JSON"):
        # facts about how workmux sees THIS environment (no agent text is printed)
        try:
            r = run_workmux(["status", "--all", "--json"])
            info = f"workmux exit {r.returncode}, {len(r.stdout)} bytes out"
            try:
                j = json.loads(r.stdout)
                info += f", tmux instance {j.get('context', {}).get('instance')}, state files matching {j.get('state_files_matching_context')} of {j.get('state_files_total')}"
            except ValueError:
                info += ", output is not JSON: " + clean_line(r.stderr or r.stdout, 160)
            print("INFO " + info)
        except Exception as e:
            print(f"INFO workmux could not run: {type(e).__name__}")
        print("INFO TMUX set: " + ("yes" if os.environ.get("TMUX") else "no") + f", LANG={os.environ.get('LANG')}")
    try:
        agents = load_agents(c)
    except Exception as e:
        print(f"FAIL agents: {type(e).__name__}")
        return 1
    print(f"OK agents: {len(agents)} (" + ", ".join(sorted({a['state'] for a in agents})) + ")")
    if agents:
        try:
            raw, w = capture_raw(agents[0]["pane"], c, int(c["capture_lines"]) + 80)
            n = len(render_pane(raw, w, "smart", int(c["capture_lines"]), int(c["capture_max_chars"])))
            print(f"OK capture: {n} characters of page rendered from the first agent's pane (content not printed)")
        except Exception as e:
            print(f"FAIL capture: {type(e).__name__}")
            return 1
    return 0

def main():
    ap = argparse.ArgumentParser(prog="phone-hub", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name, fn in (("serve", cmd_serve), ("ensure", cmd_ensure), ("restart", cmd_restart), ("supervise", cmd_supervise), ("pair", cmd_pair), ("devices", cmd_devices), ("off", cmd_off),
                     ("on", cmd_on), ("status", cmd_status), ("selftest", cmd_selftest)):
        sub.add_parser(name).set_defaults(fn=fn)
    p = sub.add_parser("set-pin"); p.add_argument("--stdin", action="store_true", help=argparse.SUPPRESS); p.set_defaults(fn=cmd_set_pin)
    p = sub.add_parser("revoke"); p.add_argument("id"); p.set_defaults(fn=cmd_revoke)
    p = sub.add_parser("log"); p.add_argument("-n", type=int, default=30); p.set_defaults(fn=cmd_log)
    args = ap.parse_args()
    return args.fn(args)

if __name__ == "__main__":
    sys.exit(main())
