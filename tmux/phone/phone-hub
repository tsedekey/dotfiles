def config_problem(c):
    """"" when the two identity settings are usable, else what is wrong. They have no default on purpose: an empty `login` would
    match a request that has no identity header at all, so the hub must refuse to run (and to answer) until both are set."""
    login, host = str(c.get("login") or "").strip(), str(c.get("host") or "").strip()
    if not login or not host:
        return "set \"login\" (your Tailscale login) and \"host\" (this machine's tailnet name) in " + CONFIG_FILE
    if "@" not in login or "." not in host or "/" in host or " " in host or ":" in host:
        return "\"login\" must look like you@example.com and \"host\" like machine.your-tailnet.ts.net, without a port (see " + CONFIG_FILE + ")"
    return ""

