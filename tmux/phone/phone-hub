def page(title, body, refresh=0, status=200):
    meta = f'<meta http-equiv="refresh" content="{int(refresh)}">' if refresh else ""
    doc = (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
           f'<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">'
           f'<meta name="apple-mobile-web-app-capable" content="yes"><meta name="mobile-web-app-capable" content="yes">'
           f'<meta name="apple-mobile-web-app-title" content="Agents"><meta name="apple-mobile-web-app-status-bar-style" content="default">'
           f'<link rel="apple-touch-icon" href="/icon.png"><meta name="theme-color" content="#0f172a">{meta}'
           f'<title>{esc(title)}</title><style>{CSS}</style></head><body><main>{body}</main></body></html>')
    return status, doc.encode("utf-8"), "text/html; charset=utf-8"

TAGS = {"waiting": "WAIT", "done": "DONE", "working": "WORK", "stale": "STALE"}
KINDS = {"claude": "cl", "copilot": "co", "opencode": "oc"}

def row_html(a):
    tag = TAGS.get(a["state"], "?")
    return (f'<a class="row" href="/a/p{esc(a["pane"].lstrip("%"))}#end"><div class="top"><span class="tag {esc(a["state"])}">{esc(tag)}</span>'
            f'<span class="mut">{esc(fmt_age(a["elapsed"]))}</span><span class="mut">{esc(KINDS.get(a["kind"], a["kind"][:2]))}</span>'
            f'<span class="where">{esc(a["session"])}:{esc(a["window"])}</span></div><div class="title">{esc(a["title"])}</div></a>')

def render_list(agents, c, auto):
    live = [a for a in agents if a["state"] != "stale"]
    old = [a for a in agents if a["state"] == "stale"]
    body = '<h1>Agents</h1>'
    body += "".join(row_html(a) for a in live) or '<p class="mut">No agents need a look.</p>'
    if old:
        body += f'<details><summary>{len(old)} older (done for over {int(c["stale_hours"])}h)</summary>' + "".join(row_html(a) for a in old) + '</details>'
    toggle = '<a href="/?r=0">Pause auto-refresh</a>' if auto else '<a href="/">Resume auto-refresh</a>'
    body += f'<p class="mut"><a href="/">Refresh</a> &middot; {toggle}</p>'
    body += '<form method="post" action="/logout"><input type="hidden" name="t" value="__CSRF__"><button type="submit">Lock</button></form>'
    return body


# ------------------------------------------------------------------ server state
STATE = {"sessions": {}, "hits": deque(), "lock": threading.Lock()}

def cookie_header(name, value, max_age):
    return f"{name}={value}; Path=/; Max-Age={int(max_age)}; Secure; HttpOnly; SameSite=Lax"

def words_code():
    try:
        words = [w.strip() for w in open("/usr/share/dict/words", errors="ignore")]
        words = sorted({w for w in words if re.fullmatch(r"[a-z]{4,7}", w)})
        if len(words) > 5000:
            return "-".join(pysecrets.choice(words) for _ in range(3))
    except OSError:
        pass
    return "-".join(pysecrets.token_hex(2) for _ in range(3))

def hash_pin(pin, salt, iters=PIN_ITERS):
    return hashlib.pbkdf2_hmac("sha256", pin.encode(), salt, iters)


class Handler(BaseHTTPRequestHandler):  # Pages (step D) is mixed in below
    server_version = "phone-hub"
    sys_version = ""
    timeout = 10

    def log_message(self, *a):
        pass

    # ---- response helpers
    def respond(self, status, body, ctype="text/plain; charset=utf-8", headers=()):
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; img-src 'self'; form-action 'self'; base-uri 'none'; frame-ancestors 'none'")
        for k, v in headers:
            self.send_header(k, v)
        self.send_header("Connection", "close")
        self.end_headers()
        self.wfile.write(body)
        self.close_connection = True

    def deny(self, status=403, text="Not allowed."):
        self.respond(status, text.encode())

    def redirect(self, where, headers=()):
        self.respond(303, b"", headers=[("Location", where), *headers])

    def send_page(self, tup, headers=()):
        status, body, ctype = tup
        self.respond(status, body, ctype, headers)

    # ---- request plumbing
    def do_GET(self):
        self.route("GET")

    def do_POST(self):
        self.route("POST")

    def _other(self):
        self.deny(405, "Method not allowed.")
    do_PUT = do_DELETE = do_PATCH = do_OPTIONS = do_HEAD = _other

    def form(self, limit=None):
        try:
            n = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            n = -1
        if n < 0 or n > (limit or MAX_BODY):
            return None
        if "application/x-www-form-urlencoded" not in (self.headers.get("Content-Type") or ""):
            return None
        raw = self.rfile.read(n).decode("utf-8", "replace")
        return {k: v[0] for k, v in parse_qs(raw, keep_blank_values=True).items()}

    def cookies(self):
        c = SimpleCookie()
        try:
            c.load(self.headers.get("Cookie") or "")
        except Exception:
            return {}
        return {k: m.value for k, m in c.items()}

    def device(self):
        tok = self.cookies().get("ph_dev")
        if not tok or len(tok) > 200:
            return None
        h = sha(tok)
        with SLOCK:
            d = sload()
            rec = d["devices"].get(h)
            if not rec:
                return None
            if now() - rec.get("last_seen", 0) > 60:
                rec["last_seen"] = now()
                ssave(d)
        return h[:8], rec

    def session(self, devid):
        tok = self.cookies().get("ph_sess")
        if not tok or len(tok) > 200:
            return None
        c = cfg()
        with STATE["lock"]:
            s = STATE["sessions"].get(sha(tok))
            if not s:
                return None
            t = now()
            if s["dev"] != devid or t - s["last"] > c["session_idle_secs"] or t - s["created"] > c["session_max_secs"]:
                STATE["sessions"].pop(sha(tok), None)
                return None
            s["last"] = t
            return s

    def xff_chain(self):
        return clean_line(self.headers.get("X-Forwarded-For") or "", 200)

    def client_ip(self):
        # the RIGHTMOST entry is the one our own proxy appended; anything to its left was sent by the client
        parts = [p.strip() for p in (self.headers.get("X-Forwarded-For") or "").split(",") if p.strip()]
        return parts[-1][:64] if parts else ""

    # ---- the one place every request goes through
    def route(self, method):
        c = cfg()
        path, _, query = self.path.partition("?")
        if len(self.path) > 300:
            return self.deny(414, "Not allowed.")
        if path == "/healthz":
            return self.respond(200, b"ok")
        if os.path.exists(DISABLED_FILE):
            return self.deny(503, "Switched off.")
        with STATE["lock"]:
            t = now()
            while STATE["hits"] and t - STATE["hits"][0] > 60:
                STATE["hits"].popleft()
            if len(STATE["hits"]) >= int(c["rate_per_minute"]):
                return self.deny(429, "Slow down.")
            STATE["hits"].append(t)

        if config_problem(c):
            audit("deny_unconfigured")
            return self.deny(503, "Not configured.")
        raw_host = self.headers.get("Host") or ""
        host = raw_host.split(":")[0].strip().lower()
        login = self.headers.get("Tailscale-User-Login") or ""
        if path == "/whoami":
            return self.whoami(c, login, raw_host)
        seen = dict(host=clean_line(raw_host, 80), xfh=clean_line(self.headers.get("X-Forwarded-Host") or "", 80),
                    has_identity=bool(login), xff=self.xff_chain())
        if host != c["host"].lower():
            audit("deny_host", **seen)
            return self.deny()
        if not hmac.compare_digest(login.encode(), c["login"].encode()):
            audit("deny_identity", **seen)
            return self.deny()
        if c.get("allowed_sources") and self.client_ip() and self.client_ip() not in c["allowed_sources"]:
            audit("deny_source", ip=self.client_ip())
            return self.deny()
        if path == "/icon.png" and method == "GET":
            return self.respond(200, ICON, "image/png", [("Cache-Control", "max-age=86400")])

        dev = self.device()
        if path == "/pair":
            return self.pair(c, method, dev)
        if not dev:
            if method == "GET":
                return self.redirect("/pair")
            return self.deny()
        devid, devrec = dev
        if path == "/login":
            return self.login(c, method, devid, devrec)
        sess = self.session(devid)
        if not sess:
            return self.redirect("/login") if method == "GET" else self.deny()

        if path == "/" and method == "GET":
            return self.index(c, sess, devrec, query)
        if path.startswith("/a/"):
            return self.agent_routes(c, sess, devrec, devid, method, path, query)
        if path.startswith("/job/"):
            return self.job_routes(c, sess, devrec, devid, method, path)
        if path == "/reauth":
            return self.reauth(c, method, sess, devid, devrec, query)
        if path == "/logout" and method == "POST":
            f = self.form() or {}
            if not hmac.compare_digest(f.get("t", ""), sess["csrf"]):
                return self.deny()
            tok = self.cookies().get("ph_sess", "")
            with STATE["lock"]:
                STATE["sessions"].pop(sha(tok), None)
            audit("logout", dev=devrec.get("label"))
            return self.redirect("/login", [("Set-Cookie", cookie_header("ph_sess", "", 0))])
        return self.deny(404, "Not found.")

    # ---- pages
    def whoami(self, c, login, raw_host):
        """Diagnostics only: shows what the proxy delivered. Shows no secret and is allowed even when the Host is wrong
        (so a rewritten Host header can be seen instead of a blank refusal)."""
        names = sorted(k for k in self.headers.keys() if k.lower().startswith(("tailscale", "x-forwarded", "x-real")))
        ok = bool(login) and hmac.compare_digest(login.encode(), c["login"].encode())
        host_ok = raw_host.split(":")[0].strip().lower() == c["host"].lower()
        body = ('<h1>Connection check</h1>'
                f'<p>Host header received: <b>{esc(clean_line(raw_host, 80))}</b> ({"correct" if host_ok else "NOT what the hub expects"})</p>'
                f'<p>Identity header: <b>{"present, matches" if ok else ("present, does not match" if login else "MISSING")}</b></p>'
                f'<p>X-Forwarded-For (whole chain): <b>{esc(self.xff_chain() or "not sent")}</b></p>'
                f'<p>Client address the hub would use: <b>{esc(self.client_ip() or "not forwarded")}</b></p>'
                f'<p class="mut">Proxy headers seen: {esc(", ".join(names) or "none")}</p>')
        audit("whoami", host_ok=host_ok, identity=("match" if ok else ("other" if login else "missing")), xff=self.xff_chain())
        self.send_page(page("Connection check", body))

    def pair(self, c, method, dev):
        with SLOCK:
            d = sload()
            p = d.get("pair") or {}
        active = bool(p) and now() < p.get("expires", 0) and not p.get("used")
        locked = max(0, d.get("pair_locked_until", 0) - now())
        if method == "GET":
            if dev:
                return self.redirect("/")
            hint = ('<p class="mut">Tip: pair inside the app you will use every day. Add this page to your Home Screen first '
                    '(Share, Add to Home Screen), open it from the icon, then enter the code there. The Home Screen app and '
                    'Safari do not share their sign-in.</p>')
            if locked > 0:
                body = f'<h1>Pair this phone</h1><p class="err">Too many tries. Try again in {int(locked // 60) + 1} minutes.</p>{hint}'
            elif not active:
                body = ('<h1>Pair this phone</h1><p>No pairing is in progress.</p><p class="mut">On the Mac, in a terminal, run '
                        '<b>phone-hub pair</b> and enter the code it shows.</p>' + hint)
            else:
                body = ('<h1>Pair this phone</h1><form method="post" action="/pair">'
                        '<label>Code from the Mac</label><input type="text" name="code" autocapitalize="none" autocorrect="off" autocomplete="off">'
                        '<label>Name for this phone</label><input type="text" name="label" value="iPhone" maxlength="40">'
                        '<button type="submit">Pair</button></form>' + hint)
            return self.send_page(page("Pair", body))
        f = self.form()
        if f is None:
            return self.deny(400, "Bad request.")
        if locked > 0 or not active:
            audit("pair_refused")
            return self.deny()
        ok = hmac.compare_digest(sha((f.get("code") or "").strip().lower()), p.get("hash", ""))
        with SLOCK:
            d = sload()
            p = d.get("pair") or {}
            if not ok:
                p["fails"] = p.get("fails", 0) + 1
                audit("pair_fail", n=p["fails"])
                if p["fails"] >= int(c["max_failures"]):
                    d.pop("pair", None)
                    d["pair_locked_until"] = now() + int(c["lockout_secs"])
                    audit("pair_locked")
                else:
                    d["pair"] = p
                ssave(d)
                return self.deny()
            token = pysecrets.token_urlsafe(32)
            label = re.sub(r"[^\w .\-]", "", f.get("label") or "")[:40].strip() or "device"
            d["devices"][sha(token)] = {"label": label, "created": now(), "last_seen": now()}
            d.pop("pair", None)
            ssave(d)
        audit("pair_ok", dev=label)
        return self.redirect("/login", [("Set-Cookie", cookie_header("ph_dev", token, 31536000))])

    def login(self, c, method, devid, devrec):
        with SLOCK:
            d = sload()
        pin = d.get("pin")
        if method == "GET":
            if self.session(devid):
                return self.redirect("/")
            if not pin:
                body = '<h1>PIN not set</h1><p class="mut">On the Mac, in a terminal, run <b>phone-hub set-pin</b>.</p>'
            else:
                body = ('<h1>Unlock</h1><form method="post" action="/login"><label>PIN</label>'
                        '<input type="password" name="pin" inputmode="numeric" pattern="[0-9]*" autocomplete="off" autofocus>'
                        '<button type="submit">Unlock</button></form>')
            return self.send_page(page("Unlock", body))
        if method != "POST" or not pin:
            return self.deny()
        f = self.form()
        if f is None:
            return self.deny(400, "Bad request.")
        res, until = self.verify_pin(c, devid, devrec, f.get("pin", ""), "login")
        if res == "locked":
            return self.send_page(page("Locked", f'<h1>Locked</h1><p class="err">Too many wrong PINs. Try again in {int((until - now()) // 60) + 1} minutes.</p>', status=429))
        if res == "bad":
            return self.send_page(page("Unlock", '<h1>Unlock</h1><p class="err">Wrong PIN.</p><form method="post" action="/login"><label>PIN</label><input type="password" name="pin" inputmode="numeric" pattern="[0-9]*" autocomplete="off" autofocus><button type="submit">Unlock</button></form>', status=403))
        sid = pysecrets.token_urlsafe(32)
        with STATE["lock"]:
            STATE["sessions"][sha(sid)] = {"dev": devid, "created": now(), "last": now(), "pin_at": now(), "csrf": pysecrets.token_urlsafe(16)}
        audit("login_ok", dev=devrec.get("label"))
        return self.redirect("/", [("Set-Cookie", cookie_header("ph_sess", sid, int(c["session_max_secs"])))])

    def verify_pin(self, c, devid, devrec, pin_text, event):
        """-> ("ok"|"bad"|"locked", locked_until). Shared by login and re-entering the PIN before a write; same lockout counters."""
        with SLOCK:
            d = sload()
            pin = d.get("pin")
            until = max(d["fail"]["global"].get("until", 0), d["fail"]["dev"].get(devid, {}).get("until", 0))
            if not pin:
                return "bad", 0
            if until > now():
                audit(event + "_locked", dev=devrec.get("label"))
                return "locked", until
            salt = base64.b64decode(pin["salt"])
            good = hmac.compare_digest(hash_pin(pin_text, salt, int(pin["iters"])), base64.b64decode(pin["hash"]))
            recs = [d["fail"]["global"], d["fail"]["dev"].setdefault(devid, {"n": 0, "until": 0})]
            if not good:
                for r in recs:
                    r["n"] = r.get("n", 0) + 1
                    if r["n"] >= int(c["max_failures"]):
                        r["until"] = now() + int(c["lockout_secs"]); r["n"] = 0
                ssave(d)
                audit(event + "_fail", dev=devrec.get("label"))
                return "bad", 0
            for r in recs:
                r["n"] = 0
            ssave(d)
            return "ok", 0

    def pin_fresh(self, c, sess):
        return now() - sess.get("pin_at", 0) <= int(c["pin_fresh_secs"])

    def csrf_ok(self, sess, f):
        return f is not None and hmac.compare_digest(f.get("t", ""), sess["csrf"])

    @staticmethod
    def safe_next(n):
        return n if any(rx.match(n or "") for rx in NEXT_OK) else "/"

    def reauth(self, c, method, sess, devid, devrec, query):
        if method == "GET":
            nxt = self.safe_next((parse_qs(query).get("next") or [""])[0])
            body = ('<h1>PIN again</h1><p class="mut">Sending or starting something needs your PIN within the last few minutes.</p>'
                    f'<form method="post" action="/reauth"><input type="hidden" name="t" value="{esc(sess["csrf"])}"><input type="hidden" name="next" value="{esc(nxt)}">'
                    '<label>PIN</label><input type="password" name="pin" inputmode="numeric" pattern="[0-9]*" autocomplete="off" autofocus>'
                    '<button type="submit">Continue</button></form>')
            return self.send_page(page("PIN", body))
        f = self.form()
        if not self.csrf_ok(sess, f):
            return self.deny()
        nxt = self.safe_next(f.get("next", ""))
        res, until = self.verify_pin(c, devid, devrec, f.get("pin", ""), "reauth")
        if res == "locked":
            return self.send_page(page("Locked", f'<h1>Locked</h1><p class="err">Too many wrong PINs. Try again in {int((until - now()) // 60) + 1} minutes.</p>', status=429))
        if res == "bad":
            return self.send_page(page("PIN", '<h1>PIN again</h1><p class="err">Wrong PIN.</p><p><a href="' + esc(nxt) + '">Back</a></p>', status=403))
        with STATE["lock"]:
            sess["pin_at"] = now()
        audit("reauth_ok", dev=devrec.get("label"))
        return self.redirect(nxt)

    def index(self, c, sess, devrec, query):
        auto = "r=0" not in query
        try:
            agents = load_agents(c)
            body = render_list(agents, c, auto)
        except Exception:
            audit("agents_read_failed")
            body = '<h1>Agents</h1><p class="err">Could not read the agent list.</p><p><a href="/">Try again</a></p>'
        body = body.replace("__CSRF__", esc(sess["csrf"]))
        self.send_page(page("Agents", body, refresh=int(c["list_refresh_secs"]) if auto else 0))

    def agent(self, c, sess, devrec, seg, query=""):
        if not URLPANE_RE.match(seg):
            return self.deny(404, "Not found.")
        pane = "%" + seg[1:]
        try:
            agents = load_agents(c)
        except Exception:
            audit("agents_read_failed")
            return self.deny(404, "Not found.")
        a = next((x for x in agents if x["pane"] == pane), None)
        if not a:
            return self.deny(404, "Not found.")
        q = parse_qs(query)
        mode = "exact" if q.get("v", [""])[0] == "exact" else "smart"
        try:
            n = int(q.get("n", [""])[0])
        except ValueError:
            n = int(c["capture_lines"])
        n = n if n in (60, 120, 250, 500) else int(c["capture_lines"])
        try:
            raw, width = capture_raw(pane, c, n + 80)
            card = render_pane(raw, width, mode, n, int(c["capture_max_chars"]))
            shown = card or '<p class="mut">Nothing to show yet.</p>'
        except Exception:
            shown = '<p class="err">Could not read this agent&rsquo;s screen.</p>'
        base = f"/a/p{seg[1:]}"
        other = "smart" if mode == "exact" else "exact"
        tools = (f'<p class="tools"><a href="{base}?v={mode}&amp;n={n}#end">Refresh</a>'
                 f'<a href="{base}?v={other}&amp;n={n}#end">{"Reading view" if other == "smart" else "Exact view (scroll sideways)"}</a>'
                 + "".join(f'<a href="{base}?v={mode}&amp;n={k}#end">{k} lines</a>' for k in (60, 120, 250, 500) if k != n) + '</p>')
        audit("view_agent", dev=devrec.get("label"), pane=pane, mode=mode, lines=n)
        try:
            sstate = screen_info(raw, a["kind"])["state"]
        except Exception:
            sstate = "unknown"
        ans = f'<a class="btn" style="background:#b45309" href="{base}/keys">Answer the question</a> '
        rep_ = f'<a class="btn" href="{base}/reply">Reply</a> '
        # the screen decides; workmux `waiting` on a screen that is not recognised as a dialog offers both
        act = ans if sstate == "dialog" else (rep_ + (ans if a["state"] == "waiting" and sstate != "idle" else ""))
        tag = TAGS.get(a["state"], "?")
        body = (f'<p><a href="/">&larr; Agents</a></p><div class="top"><span class="tag {esc(a["state"])}">{esc(tag)}</span>'
                f'<span class="mut">{esc(fmt_age(a["elapsed"]))}</span><span class="mut">{esc(KINDS.get(a["kind"], a["kind"][:2]))}</span></div>'
                f'<h1>{esc(a["session"])}:{esc(a["window"])}</h1><p class="mut">{esc(a["title"])}</p>'
                f'<p>{act}<a class="btn" href="/">Back</a> <a class="btn" href="{base}/files">Files</a> <a class="btn" href="{base}/review">Review diff</a> <a class="btn" href="#end">Jump to latest</a></p>{tools}{shown}'
                f'<div id="end"></div><p class="mut">Last {n} lines. Reading this page changes nothing; Reply, Answer and Files are where you act.</p>')
        self.send_page(page(f'{a["session"]}:{a["window"]}', body))


def _lookup_agent(c, pane):
    try:
        return next((x for x in load_agents(c) if x["pane"] == pane), None)
    except Exception:
        return None

def _age(ts):
    return fmt_age(max(0, now() - ts))

def _size(n):
    return f"{n / 1024:.0f} KB" if n >= 1024 else f"{n} B"

def feedback_text(j, v):
    if j.get("kind") == "review":
        what = v.get("label") or REVIEW_TYPES.get(j.get("diff_type"), "diff")
        return f"Code review feedback on {j['file']} ({what}):\n\n{v['feedback']}"
    return f"Plannotator feedback on {j['file']}:\n\n{v['feedback']}"

JOB_LOCK = threading.Lock()


class Pages:
    """Step D pages, mixed into the handler."""

    def agent_routes(self, c, sess, devrec, devid, method, path, query):
        parts = path[3:].split("/")
        seg = parts[0]
        if not URLPANE_RE.match(seg):
            return self.deny(404, "Not found.")
        if len(parts) == 1 and method == "GET":
            return self.agent(c, sess, devrec, seg, query)
        a = _lookup_agent(c, "%" + seg[1:])
        if not a:
            return self.deny(404, "Not found.")
        if parts[1:] == ["files"] and method == "GET":
            return self.files_page(c, sess, devrec, a, seg)
        if parts[1:] == ["review"] and method == "GET":
            return self.review_page(c, sess, devrec, a, seg)
        if parts[1:] == ["review", "start"] and method == "POST":
            return self.start_review(c, sess, devrec, devid, a, seg)
        route = (method, "/".join(parts[1:]))
        for key, fn in ((("GET", "reply"), self.reply_form), (("POST", "reply"), self.reply_preview), (("POST", "reply/send"), self.reply_send),
                        (("GET", "keys"), self.keys_page), (("GET", "keys/confirm"), self.keys_confirm), (("POST", "keys/press"), self.keys_press),
                        (("POST", "keys/text"), self.keys_text)):
            if route == key:
                return fn(c, sess, devrec, a, seg, query)
        if len(parts) >= 3 and parts[1] == "f" and FID_RE.match(parts[2]):
            if len(parts) == 3 and method == "GET":
                return self.file_page(c, sess, devrec, a, seg, parts[2])
            if len(parts) == 4 and parts[3] == "start" and method == "POST":
                return self.start_annotate(c, sess, devrec, devid, a, seg, parts[2])
        return self.deny(404, "Not found.")

    def files_page(self, c, sess, devrec, a, seg):
        arts = list_artifacts(a, c)
        base = f"/a/p{seg[1:]}"
        rows = "".join(f'<a class="row" href="{base}/f/{esc(x["id"])}"><div class="where">{esc(x["rel"])}</div>'
                       f'<div class="title">{esc(x["folder"])} &middot; {esc(_size(x["size"]))} &middot; {esc(_age(x["mtime"]))} ago</div></a>' for x in arts)
        if not rows:
            rows = ('<p class="mut">No .md, .html or .txt files found in this agent&rsquo;s folders. Code checkouts are not scanned; '
                    'only the folder where its side shell sits and its own working folder, and only inside the allowed locations.</p>')
        audit("view_files", dev=devrec.get("label"), pane=a["pane"], n=len(arts))
        body = (f'<p><a href="{base}#end">&larr; {esc(a["session"])}:{esc(a["window"])}</a></p><h1>Files</h1>'
                f'<p class="mut">Newest first. Pick one to annotate it on the phone.</p>{rows}')
        self.send_page(page("Files", body))

    def file_page(self, c, sess, devrec, a, seg, fid):
        art = next((x for x in list_artifacts(a, c) if x["id"] == fid), None)
        if not art:
            return self.deny(404, "Not found.")
        base = f"/a/p{seg[1:]}"
        notes = ""
        if a["state"] == "waiting":
            notes += ('<p class="err">This agent is waiting on a question right now. You can still annotate, but the feedback cannot be typed into '
                      'it until it is back at its prompt.</p>')
        if not self.pin_fresh(c, sess):
            notes += '<p class="mut">You will be asked for your PIN again before it starts.</p>'
        body = (f'<p><a href="{base}/files">&larr; Files</a></p><h1>{esc(art["rel"])}</h1>'
                f'<p class="mut">{esc(art["folder"])} &middot; {esc(_size(art["size"]))} &middot; changed {esc(_age(art["mtime"]))} ago</p>{notes}'
                f'<p class="mut">This opens the file in Plannotator on your phone. Nothing is sent to the agent until you review your feedback here and tap Send.</p>'
                f'<form method="post" action="{base}/f/{esc(fid)}/start"><input type="hidden" name="t" value="{esc(sess["csrf"])}">'
                f'<button type="submit">Start annotating</button></form>')
        self.send_page(page(art["rel"], body))

    def start_annotate(self, c, sess, devrec, devid, a, seg, fid):
        f = self.form()
        if not self.csrf_ok(sess, f):
            return self.deny()
        base = f"/a/p{seg[1:]}"
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next={base}/f/{fid}")
        art = next((x for x in list_artifacts(a, c) if x["id"] == fid), None)
        if not art:
            return self.deny(404, "Not found.")
        if running_jobs() >= int(c["job_max_running"]) or jobs_last_hour() >= int(c["job_max_per_hour"]):
            audit("annotate_refused", dev=devrec.get("label"), why="limit")
            return self.send_page(page("Busy", '<h1>Too many sessions</h1><p class="err">Too many annotation sessions are open or were started in the last hour. Finish or cancel one first.</p>', status=429))
        try:
            jid = start_job(c, devid, a, art)
        except Exception:
            audit("annotate_refused", dev=devrec.get("label"), why="spawn")
            return self.send_page(page("Could not start", '<h1>Could not start</h1><p class="err">The annotation helper could not be started.</p>', status=500))
        audit("annotate_start", dev=devrec.get("label"), pane=a["pane"], job=jid, file=art["id"])
        return self.redirect(f"/job/{jid}")

    def review_page(self, c, sess, devrec, a, seg):
        repos = agent_repos(a, c)
        base = f"/a/p{seg[1:]}"
        csrf = f'<input type="hidden" name="t" value="{esc(sess["csrf"])}">'
        notes = ""
        if a["state"] == "waiting":
            notes += '<p class="err">This agent is waiting on a question right now. You can still review, but the feedback cannot be typed into it until it is back at its prompt.</p>'
        if not self.pin_fresh(c, sess):
            notes += '<p class="mut">You will be asked for your PIN again before it starts.</p>'
        cards = ""
        for r in repos:
            btns = "".join(f'<form method="post" action="{base}/review/start" style="display:inline">{csrf}<input type="hidden" name="r" value="{esc(r["id"])}">'
                           f'<input type="hidden" name="d" value="{esc(k)}"><button type="submit">{esc(v)}</button></form> ' for k, v in REVIEW_TYPES.items())
            cards += (f'<div class="row"><div class="where">{esc(r["name"])}</div><div class="title">branch {esc(r["branch"] or "?")}</div>'
                      f'<div style="margin-top:8px">{btns}</div></div>')
        if not cards:
            cards = ('<p class="mut">No git repository found for this agent inside the allowed folders. Only the agent&rsquo;s own working folder and '
                     'the folders of its other panes are considered.</p>')
        audit("view_review", dev=devrec.get("label"), pane=a["pane"], n=len(repos))
        body = (f'<p><a href="{base}#end">&larr; {esc(a["session"])}:{esc(a["window"])}</a></p><h1>Review a diff</h1>{notes}'
                f'<p class="mut">The diff is made on the Mac as a fixed snapshot and shown in Plannotator. The page can only show it and take your comments: '
                f'it cannot stage files, fetch, open apps, read other files or use AI.</p>{cards}')
        self.send_page(page("Review a diff", body))

    def start_review(self, c, sess, devrec, devid, a, seg):
        f = self.form()
        if not self.csrf_ok(sess, f):
            return self.deny()
        base = f"/a/p{seg[1:]}"
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next={base}/review")
        dtype = f.get("d", "")
        if dtype not in REVIEW_TYPES:
            return self.deny(400, "Bad request.")
        repo = next((r for r in agent_repos(a, c) if r["id"] == f.get("r", "")), None)
        if not repo:
            return self.deny(404, "Not found.")
        if running_jobs() >= int(c["job_max_running"]) or jobs_last_hour() >= int(c["job_max_per_hour"]):
            audit("annotate_refused", dev=devrec.get("label"), why="limit")
            return self.send_page(page("Busy", '<h1>Too many sessions</h1><p class="err">Too many annotation sessions are open or were started in the last hour. Finish or cancel one first.</p>', status=429))
        try:
            jid = start_job(c, devid, a, repo=repo, dtype=dtype)
        except Exception:
            audit("annotate_refused", dev=devrec.get("label"), why="spawn")
            return self.send_page(page("Could not start", '<h1>Could not start</h1><p class="err">The review helper could not be started.</p>', status=500))
        audit("review_start", dev=devrec.get("label"), pane=a["pane"], job=jid, repo=repo["id"], diff=dtype)
        return self.redirect(f"/job/{jid}")

    def job_routes(self, c, sess, devrec, devid, method, path):
        parts = path[5:].split("/")
        j = job_load(parts[0])
        if not j or j.get("dev") != devid:
            return self.deny(404, "Not found.")
        if len(parts) == 1 and method == "GET":
            return self.job_page(c, sess, devrec, j)
        if len(parts) == 2 and parts[1] == "send" and method == "POST":
            return self.job_send(c, sess, devrec, j)
        if len(parts) == 2 and parts[1] == "cancel" and method == "POST":
            return self.job_cancel(c, sess, devrec, j)
        return self.deny(404, "Not found.")

    def job_page(self, c, sess, devrec, j):
        v = job_view(j)
        st = v["state"]
        csrf = f'<input type="hidden" name="t" value="{esc(sess["csrf"])}">'
        head = f'<p><a href="/">&larr; Agents</a></p><h1>{esc(j["rel"])}</h1><p class="mut">for {esc(j["label"])}</p>'
        body = head
        if st == "starting":
            body += '<p>Starting&hellip;</p>'
        elif st == "waiting":
            body += ('<p>Ready. Open it, add your comments, and submit in Plannotator. This page updates by itself.</p>'
                     + (f'<p><a class="btn" href="{esc(v["url"])}" target="_blank" rel="noopener noreferrer">Open annotation</a></p>' if v["url"]
                        else '<p class="err">The session reported an address that is not allowed, so no link is shown.</p>')
                     + f'<p class="mut">Back from Plannotator and nothing changed? Safari pauses this page while you are on another tab.</p>'
                     + f'<p><a class="btn" href="/job/{esc(j["id"])}">Check now</a></p>'
                     + f'<form method="post" action="/job/{esc(j["id"])}/cancel">{csrf}<button type="submit">Cancel</button></form>')
        elif st == "finished":
            body += self.finished_block(c, sess, j, v, csrf)
        elif st == "ended":
            body += '<p class="err">The session ended without a decision (it was cancelled or timed out).</p>'
        else:
            try:
                tail = clean_line(open(os.path.join(JOBS_DIR, j["id"] + ".err"), errors="replace").read()[-300:], 160)
            except OSError:
                tail = ""
            body += f'<p class="err">It could not start{(": " + esc(tail)) if tail else "."}</p>'
        self.send_page(page("Annotation", body, refresh=3 if st in ("starting", "waiting") else 0))

    def finished_block(self, c, sess, j, v, csrf):
        dec = v["decision"]
        if dec not in ("annotated", "approved") or not v["feedback"]:
            return {"approved": "<p>Approved with no comments. Nothing to send.</p>", "dismissed": "<p>Dismissed. Nothing to send.</p>"}.get(
                dec, "<p>No feedback was recorded. Nothing to send.</p>")
        text = feedback_text(j, v)
        out = f'<p>Decision: <b>{esc(dec)}</b>, {int(v["count"])} comment(s).</p>'
        sent = j.get("sent", "")
        if sent == "sent":
            return out + '<p class="done">Sent to the agent.</p>'
        if sent == "pasted":
            return out + '<p class="err">The text was pasted into the agent&rsquo;s input but Enter was not pressed. Open the agent and press Enter, or clear the input.</p>'
        if sent == "sending":
            return out + '<p>Sending&hellip;</p>'
        if len(text) > MAX_FEEDBACK:
            return out + '<p class="err">The feedback is too long to send from the phone.</p>'
        ok, why, info = pane_guard(c, j["pane"], "type")
        out += f'<p>This exact text would be typed into <b>{esc(j["label"])}</b>, followed by Enter:</p><pre>{esc(text)}</pre>'
        if not ok:
            return out + f'<p class="err">It cannot be sent right now: {esc(why)}.</p><p class="mut">Reload this page when the agent is back at its prompt.</p>'
        return out + (f'<p class="mut">The agent will act on this text. It runs with permissions bypassed.</p>'
                      f'<form method="post" action="/job/{esc(j["id"])}/send">{csrf}<button type="submit">Send to the agent</button></form>')

    def job_send(self, c, sess, devrec, j):
        f = self.form()
        if not self.csrf_ok(sess, f):
            return self.deny()
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next=/job/{j['id']}")
        v = job_view(j)
        if v["state"] != "finished" or v["decision"] not in ("annotated", "approved") or not v["feedback"] or len(feedback_text(j, v)) > MAX_FEEDBACK:
            return self.deny(409, "Nothing to send.")
        with JOB_LOCK:
            fresh = job_load(j["id"]) or j
            if fresh.get("sent"):
                return self.deny(409, "Already sent.")
            fresh["sent"] = "sending"
            job_save(fresh)
        state, msg = send_feedback(c, fresh, v)
        fresh["sent"] = state
        fresh["sent_at"] = now()
        job_save(fresh)
        audit("send_enter", dev=devrec.get("label"), pane=fresh["pane"], job=fresh["id"], result=state or "refused")
        return self.redirect(f"/job/{j['id']}") if state else self.send_page(page("Not sent", f'<h1>Not sent</h1><p class="err">{esc(msg)}</p><p><a href="/job/{esc(j["id"])}">Back</a></p>', status=409))

    # ---------------- E1: Reply (a message for an idle agent)
    def _agent_head(self, a, seg, title):
        base = f"/a/p{seg[1:]}"
        return base, f'<p><a href="{base}#end">&larr; {esc(a["session"])}:{esc(a["window"])}</a></p><h1>{esc(title)}</h1>'

    def reply_form(self, c, sess, devrec, a, seg, query=""):
        base, head = self._agent_head(a, seg, "Reply")
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next={base}/reply")
        ok, why, info = pane_guard(c, a["pane"], "type")
        if not ok:
            more = f'<p><a class="btn" href="{base}/keys">Answer the question</a></p>' if info.get("state") == "dialog" or a["state"] == "waiting" else ""
            return self.send_page(page("Reply", head + f'<p class="err">A reply cannot be typed right now: {esc(why)}.</p>{more}<p class="mut">Reload this page when the agent is back at an empty prompt.</p>'))
        body = head + (f'<p class="mut">Typed into <b>{esc(a["session"])}:{esc(a["window"])}</b> as a message, then Enter. You see the exact text before anything is sent.</p>'
                       f'<form method="post" action="{base}/reply"><input type="hidden" name="t" value="{esc(sess["csrf"])}">'
                       f'<textarea name="text" maxlength="{REPLY_MAX}" required autocapitalize="sentences"></textarea>'
                       '<button type="submit">Preview</button></form>')
        self.send_page(page("Reply", body))

    def reply_preview(self, c, sess, devrec, a, seg, query=""):
        f = self.form(REPLY_BODY)
        if not self.csrf_ok(sess, f):
            return self.deny()
        base, head = self._agent_head(a, seg, "Reply")
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next={base}/reply")
        text, err = check_message(f.get("text", ""), REPLY_MAX)
        if err:
            return self.send_page(page("Reply", head + f'<p class="err">{esc(err)}</p><p><a class="btn" href="{base}/reply">Back</a></p>', status=400))
        ok, why, _info = pane_guard(c, a["pane"], "type")
        if not ok:
            return self.send_page(page("Reply", head + f'<p class="err">Cannot be sent right now: {esc(why)}.</p><pre>{esc(text)}</pre><p><a class="btn" href="{base}/reply">Back</a></p>', status=409))
        nonce = pysecrets.token_urlsafe(12)
        with STATE["lock"]:
            nn = STATE.setdefault("nonces", {})
            for k in [k for k, v in nn.items() if v[0] < now()]:
                nn.pop(k, None)
            nn[nonce] = (now() + 600, a["pane"], sha(text))
        body = head + (f'<p>This exact text will be typed into <b>{esc(a["session"])}:{esc(a["window"])}</b>, followed by Enter:</p><pre>{esc(text)}</pre>'
                       '<p class="mut">The agent will act on it, and it may be running with permissions bypassed. Its input box is empty now.</p>'
                       f'<form method="post" action="{base}/reply/send"><input type="hidden" name="t" value="{esc(sess["csrf"])}">'
                       f'<input type="hidden" name="n" value="{esc(nonce)}"><textarea name="text" hidden>{esc(text)}</textarea>'
                       '<button type="submit">Send to the agent</button></form>'
                       f'<p><a href="{base}/reply">Edit</a></p>')
        self.send_page(page("Reply", body))

    def reply_send(self, c, sess, devrec, a, seg, query=""):
        f = self.form(REPLY_BODY)
        if not self.csrf_ok(sess, f):
            return self.deny()
        base, head = self._agent_head(a, seg, "Reply")
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next={base}/reply")
        text, err = check_message(f.get("text", ""), REPLY_MAX)
        with STATE["lock"]:
            held = STATE.setdefault("nonces", {}).pop(f.get("n", ""), None)
        if err or not held or held[0] < now() or held[1] != a["pane"] or not hmac.compare_digest(held[2], sha(text)):
            audit("reply_refused", dev=devrec.get("label"), pane=a["pane"], why="nonce_or_text")
            return self.send_page(page("Not sent", head + f'<p class="err">Not sent: this preview expired or was already used. Start again.</p><p><a class="btn" href="{base}/reply">Reply</a></p>', status=409))
        if not rate_ok("reply", c["replies_per_10min"], 600):
            return self.deny(429, "Slow down.")
        state, msg = paste_and_enter(c, a["pane"], text, "ph-reply-" + pysecrets.token_hex(4))
        audit("reply_send", dev=devrec.get("label"), pane=a["pane"], chars=len(text), result=state or "refused")
        if state == "sent":
            return self.send_page(page("Sent", head + f'<p class="done">Sent.</p><p><a class="btn" href="{base}#end">See the agent</a></p>'))
        return self.send_page(page("Not sent", head + f'<p class="err">{esc(msg)}</p><p><a class="btn" href="{base}#end">See the agent</a></p>', status=409))

    # ---------------- E2: Keypad (answering an open question or permission dialog)
    def _dialog_view(self, c, a):
        try:
            raw, width = capture_raw(a["pane"], c, 120)
            return render_pane(raw, width, "smart", 40, int(c["capture_max_chars"])) or '<p class="mut">Nothing to show.</p>'
        except Exception:
            return '<p class="err">Could not read this agent&rsquo;s screen.</p>'

    def keys_page(self, c, sess, devrec, a, seg, query=""):
        base, head = self._agent_head(a, seg, "Answer")
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next={base}/keys")
        ok, why, info = pane_guard(c, a["pane"], "keys")
        shown = self._dialog_view(c, a)
        audit("view_keys", dev=devrec.get("label"), pane=a["pane"], dialog=ok)
        if not ok:
            return self.send_page(page("Answer", head + f'<p class="err">Nothing to answer: {esc(why)}.</p>{shown}<p><a class="btn" href="{base}/keys">Look again</a> <a class="btn" href="{base}#end">See the agent</a></p>'))
        csrf = f'<input type="hidden" name="t" value="{esc(sess["csrf"])}"><input type="hidden" name="fp" value="{esc(info["fp"])}">'
        def nav(label, k):
            return f'<form method="post" action="{base}/keys/press">{csrf}<input type="hidden" name="k" value="{k}"><button class="nav" type="submit">{label}</button></form>'
        def commit(label, k, cls="go"):
            return f'<a class="btn {cls}" href="{base}/keys/confirm?k={k}">{label}</a>'
        oc = a["kind"] == "opencode"
        pad = ('<div class="pad">' + nav("&larr;", "Left") + nav("&uarr;", "Up") + nav("&rarr;", "Right")
               + nav("Tab", "Tab") + nav("&darr;", "Down") + nav("Space", "Space") + '</div>')
        pad += '<div class="pad">' + commit("Enter", "Enter") + commit("Esc (cancel)", "Esc", "no") + '<span></span></div>'
        if not oc:
            pad += '<div class="pad">' + "".join(commit(str(i), str(i)) for i in range(1, 10)) + '</div>'
        hint = ('<p class="mut">Arrows move the highlight (nothing is answered). Tab can open a text field to amend a permission request (Claude). Enter answers the highlighted choice. '
                + ('This agent ignores number keys.' if oc else 'In many dialogs a number answers that choice immediately.') + ' Enter, Esc and numbers ask you to confirm first.</p>')
        text = (f'<details><summary>Type text into the dialog</summary><form method="post" action="{base}/keys/text">{csrf}'
                f'<input type="text" name="text" maxlength="{KEYS_TEXT_MAX}" autocapitalize="none" autocomplete="off"><button type="submit">Type it (no Enter)</button></form>'
                '<p class="mut">For a dialog that has a type-your-own-answer line: highlight that line, type here, then press Enter above.</p></details>')
        self.send_page(page("Answer", head + f'<div class="stop"><b>A dialog is open.</b> This is the screen as it is right now.</div>{shown}{hint}{pad}{text}'
                                           f'<p><a href="{base}/keys">Look again</a> &middot; <a href="{base}#end">See the agent</a></p>'))

    def keys_confirm(self, c, sess, devrec, a, seg, query=""):
        base, head = self._agent_head(a, seg, "Confirm")
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next={base}/keys")
        k = (parse_qs(query).get("k") or [""])[0]
        if k not in COMMIT_KEYS or (a["kind"] == "opencode" and k.isdigit()):
            return self.deny(404, "Not found.")
        ok, why, info = pane_guard(c, a["pane"], "keys")
        shown = self._dialog_view(c, a)
        if not ok:
            return self.send_page(page("Confirm", head + f'<p class="err">Nothing to answer: {esc(why)}.</p>{shown}<p><a class="btn" href="{base}/keys">Back</a></p>'))
        what = {"Enter": "Enter, which answers whichever choice is highlighted", "Esc": "Esc, which cancels or rejects"}.get(k, f"the number {k}, which in many dialogs answers choice {k} immediately")
        body = head + (f'<div class="stop"><b>Press {esc(k)}?</b> It will press {esc(what)}. The agent may be running with permissions bypassed.</div>{shown}'
                       f'<form method="post" action="{base}/keys/press"><input type="hidden" name="t" value="{esc(sess["csrf"])}"><input type="hidden" name="fp" value="{esc(info["fp"])}">'
                       f'<input type="hidden" name="k" value="{esc(k)}"><input type="hidden" name="ok" value="1"><button class="go" type="submit">Press {esc(k)}</button></form>'
                       f'<p><a class="btn" href="{base}/keys">Cancel</a></p>')
        self.send_page(page("Confirm", body))

    def keys_press(self, c, sess, devrec, a, seg, query=""):
        f = self.form()
        if not self.csrf_ok(sess, f):
            return self.deny()
        base, head = self._agent_head(a, seg, "Answer")
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next={base}/keys")
        k = f.get("k", "")
        key = NAV_KEYS.get(k) or COMMIT_KEYS.get(k)
        if not key or (k in COMMIT_KEYS and f.get("ok") != "1") or (a["kind"] == "opencode" and k.isdigit()):
            return self.deny(400, "Bad request.")
        if not rate_ok("keys", c["keys_per_minute"], 60):
            return self.deny(429, "Slow down.")
        good, msg = press_key(c, a["pane"], key, f.get("fp", ""))
        audit("key_press", dev=devrec.get("label"), pane=a["pane"], key=k, ok=good)
        if not good:
            return self.send_page(page("Not pressed", head + f'<p class="err">{esc(msg)}</p><p><a class="btn" href="{base}/keys">Look again</a></p>', status=409))
        time.sleep(0.6)
        return self.redirect(f"{base}/keys")

    def keys_text(self, c, sess, devrec, a, seg, query=""):
        f = self.form(6000)
        if not self.csrf_ok(sess, f):
            return self.deny()
        base, head = self._agent_head(a, seg, "Answer")
        if not self.pin_fresh(c, sess):
            return self.redirect(f"/reauth?next={base}/keys")
        text, err = check_message(f.get("text", ""), KEYS_TEXT_MAX, multiline=False)
        if err:
            return self.send_page(page("Answer", head + f'<p class="err">{esc(err)}</p><p><a class="btn" href="{base}/keys">Back</a></p>', status=400))
        if not rate_ok("keys", c["keys_per_minute"], 60):
            return self.deny(429, "Slow down.")
        good, msg = paste_to_dialog(c, a["pane"], text, f.get("fp", ""), "ph-keys-" + pysecrets.token_hex(4))
        audit("key_text", dev=devrec.get("label"), pane=a["pane"], chars=len(text), ok=good)
        if not good:
            return self.send_page(page("Not typed", head + f'<p class="err">{esc(msg)}</p><p><a class="btn" href="{base}/keys">Look again</a></p>', status=409))
        time.sleep(0.4)
        return self.redirect(f"{base}/keys")

    def job_cancel(self, c, sess, devrec, j):
        if not self.csrf_ok(sess, self.form()):
            return self.deny()
        try:
            os.kill(int(j["pid"]), 15)
        except (ProcessLookupError, ValueError, PermissionError):
            pass
        audit("annotate_cancel", dev=devrec.get("label"), job=j["id"])
        return self.redirect(f"/job/{j['id']}")


