# ------------------------------------------------------------------ text safety
ANSI_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[()][0-9A-Za-z]|\x1b[@-Z\\-_]")
CTRL_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f  ‪-‮⁦-⁩﻿]")
PRIV_RE = re.compile("[-\U000f0000-\U000ffffd\U00100000-\U0010fffd]")

def esc(s):
    return html.escape(str(s), quote=True)

def clean_line(s, n=200):
    s = PRIV_RE.sub("", ANSI_RE.sub("", str(s or "")))
    s = CTRL_RE.sub(" ", s).replace("\n", " ").replace("\r", " ").replace("\t", " ")
    return re.sub(r"\s+", " ", s).strip()[:n]

def clean_pane_text(s, cap):
    s = ANSI_RE.sub("", s or "").replace("\r\n", "\n").replace("\r", "\n")
    s = PRIV_RE.sub("", s)
    s = re.sub(r"[\x00-\x08\x0b-\x1f\x7f-\x9f  ‪-‮⁦-⁩﻿]", "", s)
    s = re.sub(r"\n{4,}", "\n\n\n", s).rstrip()
    return s[-cap:]

def fmt_age(sec):
    sec = int(sec)
    if sec < 90: return f"{sec}s"
    if sec < 5400: return f"{sec // 60}m"
    if sec < 129600: return f"{sec // 3600}h"
    return f"{sec // 86400}d"

def make_icon_png(size=180):
    bg, bars = (15, 23, 42), [(56, 189, 248), (167, 139, 250), (52, 211, 153)]
    rows = []
    m, bh, gap = size // 6, size // 7, size // 12
    for y in range(size):
        row = bytearray([0])
        for x in range(size):
            c = bg
            for i, col in enumerate(bars):
                top = m + i * (bh + gap) + size // 8
                w = size - 2 * m - (i * size // 8)
                if top <= y < top + bh and m <= x < m + w:
                    c = col
            row += bytes(c)
        rows.append(bytes(row))
    raw = zlib.compress(b"".join(rows), 9)
    def chunk(t, d):
        return struct.pack(">I", len(d)) + t + d + struct.pack(">I", zlib.crc32(t + d) & 0xffffffff)
    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0)) + chunk(b"IDAT", raw) + chunk(b"IEND", b"")

ICON = make_icon_png()


# ------------------------------------------------------------------ data sources (read-only)
def run_workmux(args, timeout=8):
    return subprocess.run(["workmux", *args], capture_output=True, text=True, timeout=timeout)

def fetch_status():
    fake = os.environ.get("PHONE_HUB_STATUS_JSON")
    if fake:
        return json.load(open(fake))
    r = run_workmux(["status", "--all", "--json"])
    if r.returncode != 0:
        raise RuntimeError("workmux status failed")
    return json.loads(r.stdout)

def load_agents(c):
    data = fetch_status()
    stale = c["stale_hours"] * 3600
    out = []
    for a in data.get("agents") or []:
        pane = str(a.get("pane_id") or "")
        if not PANE_RE.match(pane):
            continue
        el = int(a.get("elapsed_secs") or 0)
        st = str(a.get("status") or "")
        state = "stale" if st == "done" and el > stale else st
        title = re.sub(r"^[^A-Za-z0-9]+", "", clean_line(a.get("title"))).removesuffix(" - GitHub Copilot")
        out.append({"pane": pane, "state": state, "elapsed": el, "kind": clean_line(a.get("agent_kind"), 20), "workdir": str(a.get("workdir") or ""),
                    "session": clean_line(a.get("session"), 40), "window": clean_line(a.get("window_name"), 60), "title": title})
    rank = {"waiting": 0, "done": 1, "working": 2, "stale": 3}
    out.sort(key=lambda x: (rank.get(x["state"], 2), -x["elapsed"] if x["state"] == "waiting" else x["elapsed"]))
    return out

def capture_raw(pane, c, lines):
    """The pane's text WITH its colours (SGR escapes), and the pane width. The pane id was already checked against the
    agent list by the caller, and PANE_RE guarantees it is `%` + digits."""
    fake = os.environ.get("PHONE_HUB_FAKE_CAPTURE_DIR")
    if fake:
        base = os.path.join(fake, pane.lstrip("%"))
        raw = open(base + ".txt", errors="replace").read() if os.path.exists(base + ".txt") else ""
        try:
            width = int(open(base + ".width").read())
        except (OSError, ValueError):
            width = 131
        return raw, width
    if not PANE_RE.match(pane):
        raise RuntimeError("bad pane")
    r = subprocess.run(["tmux", "capture-pane", "-p", "-e", "-J", "-t", pane, "-S", "-" + str(int(lines))],
                       capture_output=True, text=True, timeout=6)
    if r.returncode != 0:
        raise RuntimeError("capture failed")
    w = subprocess.run(["tmux", "display-message", "-p", "-t", pane, "#{pane_width}"], capture_output=True, text=True, timeout=4)
    try:
        width = int(w.stdout.strip())
    except ValueError:
        width = 131
    return r.stdout, width


