def under(real, roots):
    return any(real == r or real.startswith(r + os.sep) for r in roots)

REVIEW_TYPES = {"uncommitted": "Uncommitted changes", "branch": "This branch vs its base", "last-commit": "Last commit"}

def repo_roots(c):
    out = []
    for r in c.get("repo_roots") or []:
        try:
            out.append(os.path.realpath(os.path.expanduser(str(r))))
        except Exception:
            pass
    return out

def git_read(path, *args):
    """git as a read-only tool that cannot run programs: no fsmonitor, no hooks, no pager, no prompts, no optional locks."""
    env = dict(os.environ, GIT_TERMINAL_PROMPT="0", GIT_OPTIONAL_LOCKS="0")
    try:
        r = subprocess.run(["git", "-C", path, "-c", "core.fsmonitor=false", "-c", "core.hooksPath=/dev/null", "--no-pager", *args],
                           capture_output=True, text=True, timeout=4, env=env)
    except Exception:
        return ""
    return r.stdout.strip() if r.returncode == 0 else ""

def agent_repos(a, c):
    """Git working trees this agent works in (its folder and where the other panes of its window are), inside repo_roots."""
    roots, cands, out, seen = repo_roots(c), [a.get("workdir")], [], set()
    for row in pane_rows(a["pane"]):
        if row["cmd"] != "workmux":
            cands.append(row["path"])
    for p in cands:
        if not p or not os.path.isdir(p):
            continue
        top = git_read(p, "rev-parse", "--show-toplevel")
        real = os.path.realpath(top) if top else ""
        if not real or real in seen or not under(real, roots):
            continue
        seen.add(real)
        out.append({"id": file_id(real), "top": real, "name": os.path.basename(real), "branch": git_read(real, "rev-parse", "--abbrev-ref", "HEAD")[:60]})
    return out

def file_id(real):
    return hashlib.sha256(real.encode()).hexdigest()[:12]

def pane_rows(pane):
    """Every pane of the agent's window: [{pane, path, cmd}]. Read-only."""
    fake = os.environ.get("PHONE_HUB_FAKE_PANE_PATHS")
    if fake:
        return (load_json(fake, {}) or {}).get(pane, [])
    r = subprocess.run(["tmux", "list-panes", "-t", pane, "-F", "#{pane_id}\t#{pane_current_path}\t#{pane_current_command}"],
                       capture_output=True, text=True, timeout=5)
    rows = []
    for ln in r.stdout.splitlines():
        parts = ln.split("\t")
        if len(parts) == 3:
            rows.append({"pane": parts[0], "path": parts[1], "cmd": parts[2]})
    return rows

def pane_command(pane):
    for row in pane_rows(pane):
        if row["pane"] == pane:
            return row["cmd"]
    return ""

def agent_folders(a, c):
    """Folders that can hold this agent's artifacts: its working folder plus where the OTHER panes of its window are (the case
    folder where the side shell opens), inside artifact_roots, and not a git checkout (that is code; diffs are a separate step)."""
    roots = artifact_roots(c)
    cands = [a.get("workdir")]
    for row in pane_rows(a["pane"]):
        if row["cmd"] != "workmux":                       # the workmux sidebar sits in some unrelated folder
            cands.append(row["path"])
    out = []
    for p in cands:
        if not p:
            continue
        real = os.path.realpath(p)
        if real in out or not os.path.isdir(real) or not under(real, roots) or os.path.exists(os.path.join(real, ".git")):
            continue
        out.append(real)
    return out

def list_artifacts(a, c, budget=1.5):
    roots, found, seen, t0 = artifact_roots(c), {}, 0, time.time()
    for base in agent_folders(a, c):
        stop = False
        for dp, dn, fn in os.walk(base):
            depth = dp[len(base):].count(os.sep)
            dn[:] = [d for d in dn if d not in ART_SKIP and not d.startswith(".")] if depth < 4 else []
            for f in fn:
                seen += 1
                if seen > 8000 or time.time() - t0 > budget:
                    stop = True
                    break
                if not f.lower().endswith(ART_EXT) or SECRET_NAME_RE.search(f):
                    continue
                real = os.path.realpath(os.path.join(dp, f))
                if real in found or not under(real, roots) or not os.path.isfile(real):
                    continue
                try:
                    st = os.stat(real)
                except OSError:
                    continue
                if st.st_size > MAX_ART_BYTES:
                    continue
                found[real] = {"id": file_id(real), "real": real, "rel": os.path.relpath(real, base), "folder": os.path.basename(base),
                               "mtime": st.st_mtime, "size": st.st_size}
            if stop:
                break
    return sorted(found.values(), key=lambda x: -x["mtime"])[:int(c["max_files"])]

def pid_alive(pid):
    try:
        os.kill(int(pid), 0)
        return True
    except ProcessLookupError:
        return False
    except (PermissionError, ValueError, TypeError):
        return True

def job_load(jid):
    return load_json(os.path.join(JOBS_DIR, jid + ".json"), None) if JID_RE.match(jid or "") else None

def job_save(j):
    write_json_atomic(os.path.join(JOBS_DIR, j["id"] + ".json"), j)

def job_view(j):
    """State of a job, derived from FILES (stdout lines of ph-annotate, its result file) and whether it is still running, so a hub
    restart cannot strand a job."""
    out = ""
    try:
        out = open(os.path.join(JOBS_DIR, j["id"] + ".out"), errors="replace").read()
    except OSError:
        pass
    url = next((ln[4:].strip() for ln in out.splitlines() if ln.startswith("URL ")), "")
    res = load_json(os.path.join(JOBS_DIR, j["id"] + ".result.json"), {}) or {}
    proc = JOB_PROCS.get(j["id"])
    alive = (proc.poll() is None) if proc is not None else pid_alive(j.get("pid"))
    decision = res.get("decision") or next((ln[9:].strip() for ln in out.splitlines() if ln.startswith("DECISION ")), "")
    if decision:
        state = "finished"
    elif url and alive:
        state = "waiting"
    elif alive:
        state = "starting"
    elif url:
        state = "ended"
    else:
        state = "failed"
    return {"state": state, "url": url if ANNOTATE_URL_RE.match(url) else "", "url_bad": bool(url) and not ANNOTATE_URL_RE.match(url),
            "decision": decision, "feedback": str(res.get("feedback") or ""), "count": int(res.get("annotationCount") or 0),
            "reason": str(res.get("reason") or ""), "label": clean_line(res.get("label"), 80)}

def running_jobs():
    n = 0
    try:
        names = os.listdir(JOBS_DIR)
    except OSError:
        return 0
    for nm in names:
        if nm.endswith(".json") and not nm.endswith(".result.json"):
            j = job_load(nm[:-5])
            if j and job_view(j)["state"] in ("starting", "waiting"):
                n += 1
    return n

def jobs_last_hour():
    n = 0
    try:
        names = os.listdir(JOBS_DIR)
    except OSError:
        return 0
    for nm in names:
        if nm.endswith(".json") and not nm.endswith(".result.json"):
            j = job_load(nm[:-5])
            if j and now() - float(j.get("created", 0)) < 3600:
                n += 1
    return n

def purge_jobs(keep):
    try:
        for nm in os.listdir(JOBS_DIR):
            p = os.path.join(JOBS_DIR, nm)
            if now() - os.path.getmtime(p) > keep:
                os.unlink(p)
    except OSError:
        pass

def start_job(c, devid, a, art=None, repo=None, dtype=None):
    private_dir(JOBS_DIR)
    purge_jobs(int(c["job_keep_secs"]))
    jid = pysecrets.token_urlsafe(9)
    outp, errp, resp = (os.path.join(JOBS_DIR, jid + e) for e in (".out", ".err", ".result.json"))
    env = dict(os.environ)
    env["PH_ANNOTATE_ROOTS"] = ":".join(artifact_roots(c))
    env["PH_ANNOTATE_REPO_ROOTS"] = ":".join(repo_roots(c))
    exe = os.path.expanduser(str(c["ph_annotate_path"]))
    if repo:
        argv = [exe, "--review", repo["top"], "--diff-type", dtype, "--result-file", resp, "--timeout-secs", "1800"]
        target, rel, kind = repo["top"], f'{repo["name"]}: {REVIEW_TYPES[dtype]}', "review"
    else:
        argv = [exe, art["real"], "--result-file", resp, "--timeout-secs", "1800"]
        target, rel, kind = art["real"], art["rel"], "annotate"
    with open(outp, "w") as o, open(errp, "w") as e:
        proc = subprocess.Popen(argv, stdout=o, stderr=e,
                                stdin=subprocess.DEVNULL, start_new_session=True, env=env, close_fds=True)
    JOB_PROCS[jid] = proc
    threading.Thread(target=proc.wait, daemon=True).start()
    os.chmod(outp, 0o600); os.chmod(errp, 0o600)
    job_save({"id": jid, "dev": devid, "pane": a["pane"], "label": f'{a["session"]}:{a["window"]}', "file": target, "rel": rel, "kind": kind,
              "diff_type": dtype or "", "created": now(), "pid": proc.pid, "sent": ""})
    return jid

def pane_guard(c, pane, mode="type"):
    """May this pane be typed into right now? Re-run immediately before EVERY tmux call that types or presses a key.
      mode "type": text for the input box. The SCREEN must show an empty input box (not a dialog, not working, no half-typed draft).
      mode "enter": the moment before pressing Enter after a paste: not a dialog, not working (the box may hold our text).
      mode "keys": a key for a dialog. The SCREEN must show a dialog.
    Returns (ok, reason, info) where info is the screen check."""
    info = {"state": "unknown", "draft": "", "fp": ""}
    try:
        a = next((x for x in load_agents(c) if x["pane"] == pane), None)
    except Exception:
        return False, "could not read the agent list", info
    if not a:
        return False, "that pane is not a registered agent pane", info
    if pane_command(pane) in SHELLS:
        return False, "the pane is a shell, not an agent", info
    try:
        raw, _w = capture_raw(pane, c, 80)
    except Exception:
        return False, "could not read the agent's screen", info
    info = screen_info(raw, a["kind"])
    st = info["state"]
    if mode == "keys":
        return (True, "", info) if st == "dialog" else (False, "no dialog is on the agent's screen right now", info)
    if st == "dialog":
        return False, "a question or permission dialog is on the agent's screen right now", info
    # workmux `waiting` is deliberately NOT a refusal here: measured on real agents it stays `waiting` after a dialog was answered or
    # dismissed, which would lock the phone out exactly when you want to redirect the agent. A dialog is refused because the SCREEN
    # shows one; an unrecognised screen is refused because no empty prompt can be found.
    if st == "working":
        return False, "the agent is busy working right now", info
    # workmux `working` also sticks (measured: 130+ s on an empty prompt after an Esc aborted a request; no stop hook fires). A screen
    # that shows an empty prompt and no spinner overrides it, except in the first seconds of a turn when the spinner may not be drawn yet.
    if a["state"] == "working" and a["elapsed"] < 15:
        return False, "the agent started working a moment ago", info
    if mode == "type":
        if st == "draft":
            return False, "there is unsent text in the agent's input box", info
        if st != "idle":
            return False, "the agent's screen was not recognised as an empty prompt", info
    elif st == "unknown":
        return False, "the agent's screen was not recognised", info
    return True, "", info

BAD_CTRL_RE = re.compile(r"[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f\u2028\u2029\u202a-\u202e\u2066-\u2069\ufeff]")
NAV_KEYS = {"Up": "Up", "Down": "Down", "Left": "Left", "Right": "Right", "Tab": "Tab", "Space": "Space"}
COMMIT_KEYS = {"Enter": "Enter", "Esc": "Escape", **{str(i): str(i) for i in range(1, 10)}}

def check_message(text, limit, multiline=True):
    """Validate text that will be typed into an agent. Returns (clean_text, error). Refuses rather than silently cleaning.
    A text that starts with !, / or # is refused: those are shell, slash-command and memory shortcuts in the agents (defence in
    depth: the screen check already makes sure the agent is at an empty prompt)."""
    t = (text or "").replace("\r\n", "\n").replace("\r", "\n").strip()
    if not t:
        return "", "Type something first."
    if len(t) > limit:
        return "", f"Too long: {len(t)} characters (the limit here is {limit})."
    if BAD_CTRL_RE.search(t):
        return "", "The text contains control characters, which are not allowed."
    if not multiline and "\n" in t:
        return "", "One line only here."
    if t[0] in "!/#":
        return "", "Text starting with !, / or # is not allowed from the phone (in the agents those are shell, slash-command and memory shortcuts)."
    return t, ""

def rate_ok(name, limit, window):
    with STATE["lock"]:
        dq = STATE.setdefault("w_" + name, deque())
        t = now()
        while dq and t - dq[0] > window:
            dq.popleft()
        if len(dq) >= int(limit):
            return False
        dq.append(t)
        return True

def tmux_type(args):
    r = subprocess.run(["tmux", *args], capture_output=True, text=True, timeout=6)
    return r.returncode == 0

def send_feedback(c, j, view):
    """Annotation feedback: the SAME text builder the job page shows (what you see is exactly what is typed)."""
    return paste_and_enter(c, j["pane"], feedback_text(j, view), "ph-hub-" + j["id"])

def press_key(c, pane, key, fp):
    """One key into an open dialog. The screen must show a dialog AND still be the screen the person looked at (fingerprint)."""
    ok, why, info = pane_guard(c, pane, "keys")
    if not ok:
        return False, f"Not pressed: {why}."
    if not hmac.compare_digest(info["fp"], fp or ""):
        return False, "Not pressed: the screen changed since you looked at it. Look again, then tap."
    if not tmux_type(["send-keys", "-t", pane, key]):
        return False, "Not pressed: tmux could not press the key."
    return True, ""

def paste_to_dialog(c, pane, text, fp, buf):
    """Text into a dialog's free-text field (no Enter): same two checks as press_key."""
    ok, why, info = pane_guard(c, pane, "keys")
    if not ok:
        return False, f"Not typed: {why}."
    if not hmac.compare_digest(info["fp"], fp or ""):
        return False, "Not typed: the screen changed since you looked at it. Look again, then try again."
    if not (tmux_type(["set-buffer", "-b", buf, "--", text]) and tmux_type(["paste-buffer", "-p", "-d", "-b", buf, "-t", pane])):
        return False, "Not typed: tmux could not paste the text."
    return True, ""

def paste_and_enter(c, pane, text, buf):
    """The only code that types a message into an agent's input box. Bracketed paste, then Enter, each behind its own guard.
    Returns (state, message)."""
    ok, why, _info = pane_guard(c, pane, "type")
    if not ok:
        return "", f"Not sent: {why}."
    if not (tmux_type(["set-buffer", "-b", buf, "--", text]) and tmux_type(["paste-buffer", "-p", "-d", "-b", buf, "-t", pane])):
        return "", "Not sent: tmux could not paste the text."
    ok, why, _info = pane_guard(c, pane, "enter")
    if not ok:
        return "pasted", f"The text was pasted but Enter was NOT pressed: {why}. Look at the agent and press Enter yourself, or clear the input."
    time.sleep(0.4)     # Enter must arrive AFTER the paste, not with it: Copilot treats text and Enter that arrive together as one paste
    if not tmux_type(["send-keys", "-t", pane, "Enter"]):
        return "pasted", "The text was pasted but Enter could not be pressed. Look at the agent."
    return "sent", "Sent."


# ------------------------------------------------------------------ rendering a pane for a phone
PAL16 = ["#000000", "#cd3131", "#0dbc79", "#e5e510", "#2472c8", "#bc3fbc", "#11a8cd", "#e5e5e5",
         "#666666", "#f14c4c", "#23d18b", "#f5f543", "#3b8eea", "#d670d6", "#29b8db", "#ffffff"]
TERM_FG, TERM_BG = "#d6deeb", "#0d1117"
SGR_RE = re.compile(r"\x1b\[([0-9;:]*)m")
OTHER_ESC_RE = re.compile(r"\x1b\[[0-?]*[ -/]*[@-ln-~]|\x1b\][^\x07\x1b]*(?:\x07|\x1b\\)|\x1b[()][0-9A-Za-z]|\x1b[@-Z\\-_]")
CTRL2_RE = re.compile(r"[\x00-\x08\x0b-\x1f\x7f-\x9f\u2028\u2029\u202a-\u202e\u2066-\u2069\ufeff]")
# A rule is a plain horizontal line (Claude: ────, Copilot: ╻▄▄▄… and ╹▀▀▀…). Anything with corners, joints or vertical bars is a
# box or a table, which keeps its layout in a scrolling block instead.
RULE_CHARS = set("─━═┄┈╌┅┉╍▀▄█▁▔▂▃▅▆▇╻╹╸╺-_=~*·•")
BOXLINE_RE = re.compile(r"[│┃┌┐└┘├┤┬┴┼╭╮╰╯]")
PROMPT_GLYPHS = ("❯", ">", "›")
MARK_RE = re.compile(r"^(\s*)([⏺●•▪◦·\-*+]|\d{1,3}[.)])(\s+)")

def c256(n):
    if n < 16:
        return PAL16[n]
    if n < 232:
        n -= 16
        f = lambda v: 0 if v == 0 else 55 + 40 * v
        return "#%02x%02x%02x" % (f(n // 36), f((n // 6) % 6), f(n % 6))
    g = 8 + 10 * (n - 232)
    return "#%02x%02x%02x" % (g, g, g)

def crgb(r, g, b):
    cl = lambda v: max(0, min(255, int(v)))
    return "#%02x%02x%02x" % (cl(r), cl(g), cl(b))

def apply_sgr(st, params):
    """st = [fg, bg, bold, dim, italic, underline, strike, reverse]; only validated numbers ever become CSS."""
    p = []
    for x in params.replace(":", ";").split(";")[:32]:
        try:
            p.append(int(x) if x else 0)
        except ValueError:
            p.append(0)
    if not p:
        p = [0]
    i = 0
    while i < len(p):
        c = p[i]
        if c == 0: st[:] = [None, None, False, False, False, False, False, False]
        elif c == 1: st[2] = True
        elif c == 2: st[3] = True
        elif c == 3: st[4] = True
        elif c == 4: st[5] = True
        elif c == 7: st[7] = True
        elif c == 9: st[6] = True
        elif c == 22: st[2] = st[3] = False
        elif c == 23: st[4] = False
        elif c == 24: st[5] = False
        elif c == 27: st[7] = False
        elif c == 29: st[6] = False
        elif 30 <= c <= 37: st[0] = PAL16[c - 30]
        elif 90 <= c <= 97: st[0] = PAL16[8 + c - 90]
        elif c == 39: st[0] = None
        elif 40 <= c <= 47: st[1] = PAL16[c - 40]
        elif 100 <= c <= 107: st[1] = PAL16[8 + c - 100]
        elif c == 49: st[1] = None
        elif c in (38, 48) and i + 1 < len(p):
            col = None
            if p[i + 1] == 5 and i + 2 < len(p):
                col = c256(max(0, min(255, p[i + 2]))); i += 2
            elif p[i + 1] == 2 and i + 4 < len(p):
                col = crgb(p[i + 2], p[i + 3], p[i + 4]); i += 4
            if col:
                st[0 if c == 38 else 1] = col
        i += 1

def parse_ansi(raw):
    """-> list of lines; a line is a list of (style_tuple, text). Style is reset at the start of every line."""
    out = []
    for ln in raw.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        st = [None, None, False, False, False, False, False, False]
        segs, pos = [], 0
        for m in SGR_RE.finditer(ln):
            segs.append((tuple(st), ln[pos:m.start()]))
            apply_sgr(st, m.group(1))
            pos = m.end()
        segs.append((tuple(st), ln[pos:]))
        clean = []
        for style, text in segs:
            text = PRIV_RE.sub("", CTRL2_RE.sub("", OTHER_ESC_RE.sub("", text))).replace("\t", "    ")
            if not text:
                continue
            if clean and clean[-1][0] == style:
                clean[-1] = (style, clean[-1][1] + text)
            else:
                clean.append((style, text))
        out.append(clean)
    return out

def seg_css(style):
    fg, bg, bold, dim, ital, und, strike, rev = style
    if rev:
        fg, bg = (bg or TERM_BG), (fg or TERM_FG)
    parts = []
    if fg: parts.append("color:" + fg)
    if bg: parts.append("background:" + bg)
    if bold: parts.append("font-weight:700")
    if dim: parts.append("opacity:.72")
    if ital: parts.append("font-style:italic")
    if und or strike: parts.append("text-decoration:" + " ".join(x for x, f in (("underline", und), ("line-through", strike)) if f))
    return ";".join(parts)

def segs_html(segs):
    out = []
    for style, text in segs:
        css = seg_css(style)
        out.append(f'<span style="{css}">{esc(text)}</span>' if css else esc(text))
    return "".join(out)

SCROLLBAR_CHARS = set("│┃┆┊╎╏▐▌█░▒▓▕▏")

def drop_scrollbar(segs, width):
    """Copilot (and others) draw a scrollbar in the LAST column of a full-width line. Remove that lone glyph so it is not
    mistaken for a table or a box border."""
    plain = "".join(t for _, t in segs)
    if width and len(plain) >= width - 1 and len(plain) >= 3 and plain[-1] in SCROLLBAR_CHARS and plain[-2] == " ":
        style, text = segs[-1]
        segs = list(segs[:-1]) + ([(style, text[:-1])] if len(text) > 1 else [])
    return segs

def rstrip_segs(segs):
    segs = list(segs)
    while segs:
        style, text = segs[-1]
        t = text.rstrip()
        if t:
            segs[-1] = (style, t)
            break
        segs.pop()
    return segs

def lstrip_segs(segs):
    segs = list(segs)
    while segs:
        style, text = segs[0]
        t = text.lstrip()
        if t:
            segs[0] = (style, t)
            break
        segs.pop(0)
    return segs

def dedent_lines(blk):
    """blk = list of segment lists. Removes the indentation all lines share (a right-aligned hint would otherwise open with a
    screenful of nothing); the relative indentation inside the block stays."""
    inds = [len(plain_of(l)) - len(plain_of(l).lstrip()) for l in blk if plain_of(l).strip()]
    k = min(inds) if inds else 0
    if k <= 0:
        return blk
    out = []
    for l in blk:
        l, cut = list(l), k
        while l and cut > 0:
            style, text = l[0]
            if len(text) <= cut:
                cut -= len(text); l.pop(0)
            else:
                l[0] = (style, text[cut:]); cut = 0
        out.append(l)
    return out

def plain_of(segs):
    return "".join(t for _, t in segs)

def is_rule(plain):
    t = plain.strip()
    if len(t) < 8 or BOXLINE_RE.search(t):
        return False
    return sum(1 for ch in t if ch in RULE_CHARS or ch == " ") / len(t) >= 0.9 and sum(1 for ch in t if ch in RULE_CHARS) >= 8

def bg_ratio(segs):
    """Share of the WHOLE line (spaces included) that has a background colour. A diff bar or highlighted message colours the
    entire row; inline code colours only the code words, so a sentence with some `code` in it stays prose."""
    tot = sum(len(t) for _, t in segs)
    bgd = sum(len(t) for st, t in segs if st[1] and not st[7])
    return (bgd / tot) if tot else 0

def is_pre(segs, plain, expect=None):
    """expect = the text indent of the list item / paragraph we are inside. A line indented to match it is the CONTINUATION of
    that item (e.g. the second line of "  1. text", indented 5 to sit under the text), not code or tool output."""
    indent = len(plain) - len(plain.lstrip())
    if BOXLINE_RE.search(plain) or plain.count("|") >= 2:
        return True
    if indent >= 5 and not MARK_RE.match(plain) and not (expect is not None and abs(indent - expect) <= 2):
        return True                                    # deep indent = code / tool output (a nested list item or a continuation is prose)
    if bg_ratio(segs) >= 0.85 and not plain.lstrip().startswith(PROMPT_GLYPHS):   # diff bars and code blocks keep their layout;
        return True                                                               # a highlighted message of yours is prose
    if re.match(r"^\s*\d{1,6}\s*[+\-]\s", plain) or re.match(r"^(@@|\+\+\+|---)\s", plain):
        return True
    if len(re.findall(r"\S {3,}\S", plain.replace("\xa0", ""))) >= 2:  # aligned columns (real spaces; NBSP pads inline code)
        return True
    return False

# ------------------------------------------------------------------ what is on the screen RIGHT NOW (the guard for typing)
# workmux's status is NOT trustworthy as a guard (measured on real agents): a question menu was open while it still said `working`
# for ~5 s, and it kept saying `waiting` after the dialog had gone. So the SCREEN decides; the status is only a second opinion.
DIALOG_RES = (
    re.compile(r"(?i)\besc(?:ape)?\s+to\s+(?:cancel|exit|close|dismiss|go back)\b"),   # Claude: "Esc to cancel", Copilot: "esc to cancel"
    re.compile(r"(?i)\benter\s+to\s+(?:select|confirm|submit|continue)\b"),             # Claude: "Enter to select"
    re.compile(r"(?i)↑/↓\s+to\s+(?:navigate|select)"),                                    # Claude and Copilot menus
    re.compile(r"(?i)(?:⇆|←/→)\s+select\b|\benter\s+confirm\b"),                          # OpenCode: "⇆ select  enter confirm"
    re.compile(r"\bAllow once\b.*\bReject\b"),                                           # OpenCode permission buttons
    re.compile(r"(?i)\bwould you like to proceed\?|\bready to code\?"),                    # Claude plan approval (measured: no "Esc to cancel" in its footer)
    re.compile(r"(?i)\bshift\+tab\s+to\s+approve\b|\bctrl\+g\s+to\s+edit\s+in\b"),         # Claude plan approval footer
)
# A menu is also recognised by its shape: a numbered list with a pointer on one choice ("❯ 1. Yes"), whatever the footer says.
MENU_LINE_RE = re.compile(r"^[\s│┃]*(?:[❯›]\s*)?\d{1,2}\.\s+\S")
MENU_SEL_RE = re.compile(r"^[\s│┃]*[❯›]\s*\d{1,2}\.\s+\S")
WORKING_RES = (
    re.compile(r"…\s*\(\s*(?:\d+m\s*)?\d+s\b"),                  # Claude spinner: "✽ Smooshing… (2s · thinking ...)"
    re.compile(r"(?i)\bctrl\+c\s+interrupt\b"),                   # Copilot: "◎ Working ctrl+c interrupt"
    re.compile(r"(?i)\besc\s+(?:to\s+)?interrupt\b"),             # OpenCode: "esc interrupt"; older Claude: "esc to interrupt"
)
LABELLED_RULE_RE = re.compile(r"^\s*[─━]{20,}\s")
OC_MODEL_RE = re.compile(r"^\s*┃\s+[A-Z][A-Za-z]+\s·\s")
GAP_RE = re.compile(r"\s{4,}")

def screen_lines(raw, n=40):
    """The last n non-empty lines of a capture as (plain, nodim): plain text (ANSI removed, trailing spaces removed) and the same
    line without its DIM text. Claude shows a dim suggestion of the next reply in the empty prompt: that is not a draft."""
    segs = [rstrip_segs(l) for l in parse_ansi(raw)]
    segs = [l for l in segs if plain_of(l).strip()][-n:]
    return [plain_of(l) for l in segs], ["".join(t for st, t in l if not st[3]) for l in segs]

def prompt_text(lines, kind, nodim=None):
    """The text currently in the agent's input box, "" if empty, or None if the box cannot be found (unknown screen).
    Dim text (ghost suggestions, placeholders) does not count as text."""
    nodim = nodim or lines
    if kind == "claude":
        # The TOP rule of the prompt area carries the session name once a session is renamed ("──────── name | …"), so it is
        # not a pure rule: accept a line that STARTS with a long run of rule characters. The bottom rule is always pure.
        rules = [i for i, l in enumerate(lines) if is_rule(l) or LABELLED_RULE_RE.match(l)]
        if len(rules) < 2:
            return None
        a, b = rules[-2], rules[-1]
        for i in range(a + 1, b):
            if lines[i].strip().startswith("❯"):
                t = nodim[i].strip().lstrip("❯").strip()
                return "" if t.startswith('Try "') else t
        return None
    if kind == "copilot":
        rules = [i for i, l in enumerate(lines) if is_rule(l)]
        if len(rules) < 2:
            return None
        parts = [nodim[i].strip()[1:].strip() for i in range(rules[-2] + 1, rules[-1]) if lines[i].strip().startswith("┃")]
        return " ".join(p for p in parts if p)
    if kind == "opencode":
        m = max((i for i, l in enumerate(lines) if OC_MODEL_RE.match(l)), default=None)
        if m is None:
            return None
        parts, j = [], m - 1
        while j >= 0 and lines[j].lstrip().startswith("┃"):
            chunk = GAP_RE.split(nodim[j].lstrip()[1:].strip())[0].strip()      # the right-hand sidebar sits after a wide gap
            if chunk and not chunk.startswith("Ask anything"):
                parts.append(chunk)
            j -= 1
        return " ".join(reversed(parts))
    return None

def screen_info(raw, kind):
    """-> {"state": dialog|working|idle|draft|unknown, "draft": text, "fp": fingerprint}. `unknown` means: do not type anything."""
    lines, nodim = screen_lines(raw)
    tail = lines[-30:]
    # The fingerprint includes each piece's COLOUR STYLE: OpenCode shows which button is selected only by colour, and a moved
    # highlight must change it. Digits in the text are masked (timers, counters) so a ticking clock does not.
    styled = [l for l in (rstrip_segs(x) for x in parse_ansi(raw)) if plain_of(l).strip()][-25:]
    fp = hashlib.sha256("\n".join("".join(f"{st!r}\x00{re.sub(r'[0-9]+', '#', t)}\x01" for st, t in l) for l in styled).encode()).hexdigest()[:16]
    if any(rx.search(l) for l in tail[-14:] for rx in DIALOG_RES) or (
            any(MENU_SEL_RE.match(l) for l in tail[-14:]) and sum(1 for l in tail[-14:] if MENU_LINE_RE.match(l)) >= 2):
        return {"state": "dialog", "draft": "", "fp": fp}
    if any(rx.search(l) for l in tail[-14:] for rx in WORKING_RES):
        return {"state": "working", "draft": "", "fp": fp}
    t = prompt_text(lines, kind, nodim)
    if t is None:
        return {"state": "unknown", "draft": "", "fp": fp}
    return {"state": "draft" if t else "idle", "draft": t[:300], "fp": fp}

def render_pane(raw, width, mode, max_lines, max_chars):
    """Return HTML for the pane card. mode 'smart': prose reflowed and wrapped, layout-sensitive text in sideways-scrolling
    blocks, rules as thin lines, prompt area and status styled. mode 'exact': one scrolling block, no guessing."""
    lines = parse_ansi(raw[-(max_chars * 3):])
    lines = [rstrip_segs(drop_scrollbar(l, int(width))) for l in lines]
    while lines and not plain_of(lines[-1]).strip():
        lines.pop()
    lines = lines[-max_lines:]
    total = 0
    keep = []
    for l in reversed(lines):                           # character cap measured on text, keeping the END
        total += len(plain_of(l)) + 1
        if total > max_chars:
            break
        keep.append(l)
    lines = list(reversed(keep))
    if not lines:
        return ""
    if mode == "exact":
        return '<div class="term"><pre class="blk">' + "\n".join(segs_html(l) for l in lines) + '</pre></div>'

    plains = [plain_of(l) for l in lines]
    rules = [i for i, p in enumerate(plains) if is_rule(p)]
    tail = [i for i in rules if i >= len(lines) - 14]
    prompt = status = None
    if len(tail) >= 2:
        a, b = tail[-2], tail[-1]
        prompt, status, body_end = (a + 1, b), b + 1, a
    elif len(tail) == 1:
        prompt, status, body_end = None, tail[-1] + 1, tail[-1]
    else:
        body_end = len(lines)
    W = max(40, int(width))
    html_parts = []

    def block(idx_from, idx_to):
        out, i, gap = [], idx_from, False
        while i < idx_to:
            segs, plain = lines[i], plains[i]
            if not plain.strip():
                gap = True
                i += 1
                continue
            if gap and out:
                out.append('<div class="gap"></div>')
            gap = False
            if is_rule(plain):
                out.append("<hr>")
                i += 1
                continue
            if is_pre(segs, plain):
                j, grp = i, []
                while j < idx_to and plains[j].strip() and not is_rule(plains[j]) and is_pre(lines[j], plains[j]):
                    grp.append(lines[j]); j += 1
                out.append('<pre class="blk">' + "\n".join(segs_html(g) for g in dedent_lines(grp)) + '</pre>')
                i = j
                continue
            # prose run: join hard-wrapped lines back into paragraphs
            cur, cur_plain, last_full = segs, plain, len(plain) >= 0.8 * W
            m = MARK_RE.match(plain)
            text_indent = len(m.group(0)) if m else len(plain) - len(plain.lstrip())
            j = i + 1
            while j < idx_to and plains[j].strip() and not is_rule(plains[j]) and not is_pre(lines[j], plains[j], text_indent):
                nxt, nplain = lines[j], plains[j]
                nind = len(nplain) - len(nplain.lstrip())
                if last_full and not MARK_RE.match(nplain) and abs(nind - text_indent) <= 2 and not nplain.lstrip().startswith(("#", ">")):
                    cur = cur + [((None, None, False, False, False, False, False, False), " ")] + lstrip_segs(nxt)
                    cur_plain = cur_plain + " " + nplain.lstrip()
                    last_full = len(nplain) >= 0.8 * W
                    j += 1
                else:
                    break
            cls = "l"
            band = ""
            if bg_ratio(cur) >= 0.85:
                bgc = next((st[1] for st, tx in cur if st[1] and not st[7]), None)
                if bgc:
                    cls += " bgl"; band = f' style="background:{bgc}"'
            if MARK_RE.match(cur_plain): cls += " li"
            if cur_plain.lstrip().startswith(">"): cls += " q"
            if re.match(r"^\s*#{1,4}\s", cur_plain): cls += " h"
            out.append(f'<div class="{cls}"{band}>{segs_html(cur)}</div>')
            i = j
        return "".join(out)

    html_parts.append(block(0, body_end))
    if prompt:
        a, b = prompt
        html_parts.append('<hr><div class="prompt"><div class="lab">prompt area</div>'
                          + "".join(f'<div class="l">{segs_html(lines[i])}</div>' for i in range(a, b) if plains[i].strip() and plains[i].strip() not in SCROLLBAR_CHARS) + '</div><hr>')
    elif len(tail) == 1:
        html_parts.append("<hr>")
    if status is not None and status < len(lines):
        html_parts.append('<div class="status">' + "".join(f'<div>{segs_html(lines[i])}</div>' for i in range(status, len(lines)) if plains[i].strip()) + '</div>')
    return '<div class="term">' + "".join(html_parts) + '</div>'


