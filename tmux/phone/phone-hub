# ------------------------------------------------------------------ storage
def now():
    return time.time()

def iso(ts=None):
    return time.strftime("%Y-%m-%dT%H:%M:%S%z", time.localtime(ts or now()))

def load_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default

def private_dir(d):
    """Create the folder if needed and make sure only the owner can enter it (even if it already existed looser)."""
    os.makedirs(d, mode=0o700, exist_ok=True)
    os.chmod(d, 0o700)

def write_json_atomic(path, obj, mode=0o600):
    d = os.path.dirname(path)
    private_dir(d)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(obj, f, indent=1)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise

